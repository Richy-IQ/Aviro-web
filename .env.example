# Copy to .env.local and adjust for your machine.
# .env.development and .env.production hold the shared defaults; .env.local
# overrides them for you alone and is never committed.

# Where the Django API is, as this Next server reaches it.
# There is no NEXT_PUBLIC_ variable: the browser never calls Django directly,
# so the address stays out of the client bundle.
API_URL=http://localhost:8000/api

# Optional. A private address the server can use instead, where the platform
# offers one — faster, and keeps the API off the public network.
# API_INTERNAL_URL=http://aviro-backend.railway.internal:8000/api
