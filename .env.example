# Copy to .env.local and adjust for your machine.
# .env.development and .env.production hold the shared defaults; .env.local
# overrides them for you alone and is never committed.

# Base URL of the Django API, as the BROWSER will call it.
# Anything prefixed NEXT_PUBLIC_ is embedded in the client bundle — never put a
# secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Base URL of the Django API, as the SERVER will call it. Usually the same in
# development; in production this can be an internal address that never leaves
# the private network, which is faster and keeps the API off the public net.
API_INTERNAL_URL=http://localhost:8000/api
