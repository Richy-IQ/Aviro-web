# Shared production defaults. Loaded by `next build` and `next start`.
#
# These are non-secret defaults only. On a real host (Vercel, Railway, a VPS)
# set the real values as environment variables there — those win over this file
# and never enter the repository.

NEXT_PUBLIC_API_URL=https://api.aviro.ng/api
API_INTERNAL_URL=https://api.aviro.ng/api
